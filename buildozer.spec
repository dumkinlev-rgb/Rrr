[app]
title = Нажми Меня
package.name = simpleclicker
package.domain = org.example
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0

# Библиотеки, нужные для работы программы
requirements = python3,kivy

orientation = portrait
fullscreen = 0

# Настройки Android (совместимые со всеми телефонами)
android.api = 33
android.minapi = 21

# Уровень логирования 2 (покажет подробности, если что-то пойдет не так)
log_level = 2